# Copy to .env.local for local development; set the same keys in Vercel for production.

# Supabase Postgres connection string (Project Settings > Database > Connection string > Transaction pooler, port 6543).
# Leave empty locally to use the built-in PGlite database stored in .data/pglite.
DATABASE_URL=

# Optional: folder for the local PGlite database instead of .data/pglite (for isolated test copies).
PGLITE_DIR=

# Persistence backend: postgres (default) or firestore. Firestore only runs against the local emulator
# (FIRESTORE_EMULATOR_HOST) until a cloud project is approved.
DATA_BACKEND=postgres
# Firestore only: maximum documents read when a filter must be checked in memory (regex, $nin, ...). Default 2000.
FIRESTORE_SCAN_LIMIT=
# Firestore only: 1 re-runs the lead backfill scan on every server start (reads every lead and application).
# Leave empty and run `npm run backfill:leads` when needed. Postgres always runs it automatically.
LEAD_BACKFILL_AUTO=

# Long random string, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
JWT_SECRET=

# File storage: legacy (default: the public Supabase bucket below, or public/uploads locally) or firebase
# (Cloud Storage for Firebase: customer documents private, property media public; Storage emulator only for now).
FILE_STORAGE_BACKEND=legacy
# firebase only: lifetime of staff links to private documents, in seconds (60-3600, default 600).
PRIVATE_FILE_URL_TTL_SECONDS=

# Supabase Storage for uploaded documents (create a public bucket named below).
# Leave empty locally to save uploads to public/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Optional: point the site at an API on another host. Default: this app's /api.
NEXT_PUBLIC_API_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Public by design; read at build time, so redeploy after changing it.
# Empty: no analytics script and no cookie banner. With an ID, GA loads only after the visitor allows it, never in /admin-panel.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

NEXT_PUBLIC_CASHFREE_MODE=sandbox
NEXT_PUBLIC_CASHFREE_MODE_PRODUCTION=production

# Take the visitor IP from X-Forwarded-For for rate limiting. Only behind a proxy that sets it (automatic on Vercel).
TRUST_PROXY=
# Google App Hosting / Cloud Run: use the n-th X-Forwarded-For entry from the right (set in apphosting.yaml; confirm
# with scripts/check-proxy.mjs). Takes precedence over TRUST_PROXY, whose first entry a caller can spoof.
TRUST_PROXY_HOPS=

# Developer superuser for the Probiz staff sign-in (full admin, not stored in the database).
# Defaults to platformmanager / platformmanager outside production; in production it is off unless both are set.
PLATFORM_MANAGER_USERNAME=
PLATFORM_MANAGER_PASSWORD=

# New-lead WhatsApp alerts (Meta WhatsApp Cloud API). Leave empty to turn off. See README.
SITE_URL=https://probizfinance.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_ALERT_TO=

# Firebase (server only; never use a NEXT_PUBLIC_ prefix). Used when DATA_BACKEND=firestore or FILE_STORAGE_BACKEND=firebase.
# Without emulators, a real project is used only when FIREBASE_CONFIRM_PROJECT repeats FIREBASE_PROJECT_ID exactly.
# Local development needs no credentials: `npm run emulators` runs Firestore and Storage for the demo-probiz-finance project.
FIREBASE_PROJECT_ID=
FIREBASE_CONFIRM_PROJECT=
# Real projects: set the bucket explicitly (for example <project>.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=
# Credentials: Application Default Credentials are used when these are empty (managed identity on Google hosting,
# `gcloud auth application-default login` locally). A service-account key is a last-resort fallback; never commit it.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Emulator addresses (only with a demo- project), e.g. 127.0.0.1:8080 and 127.0.0.1:9199.
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Local production builds only (`next start` on this machine); never set in a hosted environment.
ALLOW_LOCAL_DB=
ALLOW_FIREBASE_EMULATORS=

# Migration utility only (npm run migrate:files): read-only legacy bucket for old KYC files.
# A non-local address also needs --confirm-legacy-host on the command line.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_BUCKET=uploads
